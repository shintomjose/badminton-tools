{
  "hosting": [
    {
      "target": "fansite",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.git/**",
        "**/.idea/**",
        "**/node_modules/**",
        "**/*.md",
        "start-local.cmd",
        "badminton-tools-c6b27-*.json",
        "**/*serviceaccount*.json",
        "**/service-account*.json",
        ".github/**"
      ],
      "headers": [
        {
          "source": "sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "default-site",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.git/**",
        "**/.idea/**",
        "**/node_modules/**",
        "**/*.md",
        "start-local.cmd",
        "badminton-tools-c6b27-*.json",
        "**/*serviceaccount*.json",
        "**/service-account*.json",
        ".github/**"
      ],
      "headers": [
        {
          "source": "sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
